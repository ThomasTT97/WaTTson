rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.keys().hasOnly([
          'id', 'email', 'displayName', 'photoURL', 'userGoal',
          'trainingMethodology', 'trainingMode', 'planMode', 'ftp',
          'planContext', 'chatHistoryJson',
          'intervalsApiKey', 'intervalsAthleteId', 'weeklyBriefingJson',
          'generatedWeeksJson', 'createdAt', 'updatedAt',
          'provider', 'accessToken', 'refreshToken', 'athleteName', 'avatarUrl', 'expiresAt'
        ])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('userGoal' in data) || (data.userGoal is string && data.userGoal.size() <= 500))
        && (!('trainingMethodology' in data) || data.trainingMethodology in ['polarized', 'pyramidal', 'norwegian'])
        && (!('trainingMode' in data) || data.trainingMode in ['cycling', 'triathlon', 'running'])
        && (!('planMode' in data) || data.planMode in ['power', 'hr'])
        && (!('ftp' in data) || (data.ftp is number && data.ftp >= 0 && data.ftp <= 1000))
        && (!('planContext' in data) || (data.planContext is string && data.planContext.size() <= 50000))
        && (!('chatHistoryJson' in data) || (data.chatHistoryJson is string && data.chatHistoryJson.size() <= 200000))
        && (!('intervalsApiKey' in data) || (data.intervalsApiKey is string && data.intervalsApiKey.size() <= 256))
        && (!('intervalsAthleteId' in data) || (data.intervalsAthleteId is string && data.intervalsAthleteId.size() <= 64))
        && (!('weeklyBriefingJson' in data) || (data.weeklyBriefingJson is string && data.weeklyBriefingJson.size() <= 50000))
        && (!('generatedWeeksJson' in data) || (data.generatedWeeksJson is string && data.generatedWeeksJson.size() <= 1000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('provider' in data) || (data.provider is string && data.provider in ['intervals', 'strava']))
        && (!('accessToken' in data) || (data.accessToken is string && data.accessToken.size() <= 2048))
        && (!('refreshToken' in data) || (data.refreshToken is string && data.refreshToken.size() <= 2048))
        && (!('athleteName' in data) || (data.athleteName is string && data.athleteName.size() <= 128))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1024))
        && (!('expiresAt' in data) || (data.expiresAt is number));
    }

    // User document path
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isSignedIn()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == request.auth.uid;
      allow update: if isSignedIn()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id;
      allow delete: if isSignedIn() && isOwner(userId) && isValidId(userId);
    }

    // Connection testing endpoint for healthchecks
    match /test/{docId} {
      allow read: if isSignedIn();
    }
  }
}
